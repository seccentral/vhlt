# Used when configuring with -DVHLT_CLANG_TIDY=ON.
# Focused on real defects; style checks are deliberately off for this legacy code.
Checks: >
  -*,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-reserved-identifier,
  -bugprone-macro-parentheses,
  performance-*,
  portability-*
WarningsAsErrors: ''
HeaderFilterRegex: '(common|hlcsg|hlbsp|hlvis|hlrad|ripent)/'
