# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Gitea personal access token for https://git.example.invalid (repository and release scope).
# Used as an HTTP header for pushes and API calls; never put it in a remote URL.
GITEA_ACCESS_TOKEN=

# Optional: full path to the CMake to use when the first `cmake` on PATH is a
# different or older one (for example the copy bundled with MinGW-w64, or a shell
# started before CMake was installed). Leave empty to use `cmake` from PATH.
CMAKE=C:\Program Files\CMake\bin\cmake.exe
